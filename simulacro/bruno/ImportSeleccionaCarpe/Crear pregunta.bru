info:
  name: Crear pregunta
  type: http
  seq: 7

http:
  method: POST
  url: "{{baseUrl}}/api/v1/questions"
  body:
    type: json
    data: |-
      {
        "question":"hola"
      }
  auth: inherit

runtime:
  variables:
    - name: baseUrl
      value: http://localhost:3000

settings:
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
  forwardAuthorizationHeader: false
